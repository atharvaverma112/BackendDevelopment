<!DOCTYPE html>
<html>

<head>

    <title>Eisenhower Matrix</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <h1>Eisenhower Matrix</h1>

    <!-- Navigation -->

    <div class="navigation">

        <a href="/view-tasks">View All Tasks</a>

    </div>


    <!-- Add Task Form -->

    <h2>Add New Task</h2>

    <form action="/tasks" method="POST">

        <label>Task Title:</label>

        <input type="text" name="title" required>

        <br><br>

        <label>Urgency:</label>

        <select name="priority" required>

            <option value="urgent">Urgent</option>

            <option value="normal">Not Urgent</option>

        </select>

        <br><br>

        <label>Importance:</label>

        <select name="importance" required>

            <option value="important">Important</option>

            <option value="not-important">Not Important</option>

        </select>

        <br><br>

        <button type="submit">Add Task</button>

    </form>

    <br>


    <!-- Eisenhower Matrix -->

    <div class="matrix">


        <!-- Do First -->

        <div class="box do-first">

            <h2>🔴 Do First</h2>

            <% tasks.forEach(task => { %>

                <% if (task.priority === "urgent" &&
                       task.importance === "important") { %>

                    <div class="task">

                        <strong><%= task.title %></strong>

                        <p>
                            Completed: <%= task.completed %>
                        </p>

                        <% if (!task.completed) { %>

                            <form
                                action="/tasks/complete/<%= task._id %>"
                                method="POST">

                                <button type="submit">
                                    Mark as Completed ✅
                                </button>

                            </form>

                        <% } else { %>

                            <p>Task Completed ✅</p>

                        <% } %>

                    </div>

                <% } %>

            <% }) %>

        </div>



        <!-- Schedule -->

        <div class="box schedule">

            <h2>🟠 Schedule</h2>

            <% tasks.forEach(task => { %>

                <% if (task.priority === "normal" &&
                       task.importance === "important") { %>

                    <div class="task">

                        <strong><%= task.title %></strong>

                        <p>
                            Completed: <%= task.completed %>
                        </p>

                        <% if (!task.completed) { %>

                            <form
                                action="/tasks/complete/<%= task._id %>"
                                method="POST">

                                <button type="submit">
                                    Mark as Completed ✅
                                </button>

                            </form>

                        <% } else { %>

                            <p>Task Completed ✅</p>

                        <% } %>

                    </div>

                <% } %>

            <% }) %>

        </div>



        <!-- Delegate -->

        <div class="box delegate">

            <h2>🔵 Delegate</h2>

            <% tasks.forEach(task => { %>

                <% if (task.priority === "urgent" &&
                       task.importance === "not-important") { %>

                    <div class="task">

                        <strong><%= task.title %></strong>

                        <p>
                            Completed: <%= task.completed %>
                        </p>

                        <% if (!task.completed) { %>

                            <form
                                action="/tasks/complete/<%= task._id %>"
                                method="POST">

                                <button type="submit">
                                    Mark as Completed ✅
                                </button>

                            </form>

                        <% } else { %>

                            <p>Task Completed ✅</p>

                        <% } %>

                    </div>

                <% } %>

            <% }) %>

        </div>



        <!-- Eliminate -->

        <div class="box eliminate">

            <h2>⚪ Eliminate</h2>

            <% tasks.forEach(task => { %>

                <% if (task.priority === "normal" &&
                       task.importance === "not-important") { %>

                    <div class="task">

                        <strong><%= task.title %></strong>

                        <p>
                            Completed: <%= task.completed %>
                        </p>

                        <% if (!task.completed) { %>

                            <form
                                action="/tasks/complete/<%= task._id %>"
                                method="POST">

                                <button type="submit">
                                    Mark as Completed ✅
                                </button>

                            </form>

                        <% } else { %>

                            <p>Task Completed ✅</p>

                        <% } %>

                    </div>

                <% } %>

            <% }) %>

        </div>


    </div>

</body>

</html>